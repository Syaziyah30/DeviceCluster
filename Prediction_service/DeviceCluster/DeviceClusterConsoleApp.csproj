<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
  </ItemGroup>

  <!-- ProjectReference, not HintPath - a stale DLL can never be picked up,
       and the configuration (Debug/Release) is no longer hardcoded. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Logic\Logic.csproj" />
    <ProjectReference Include="..\..\Model\Model.csproj" />
  </ItemGroup>

  <!-- Internal utility, kept in the repository so the build works from any
       clone location. See lib/README.md. -->
  <ItemGroup>
    <Reference Include="AppRegistryEditor">
      <HintPath>..\..\lib\AppRegistryEditor.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
