<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0-windows, not net10.0: GetConnectionString reads the SQL
         connection string from HKEY_CURRENT_USER via Microsoft.Win32.Registry,
         which is only in-framework on the Windows target. Matches
         DeviceClusterServiceApp. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
  </ItemGroup>

  <!-- ProjectReference, not HintPath - a stale DLL can never be picked up,
       and the configuration (Debug/Release) is no longer hardcoded. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Logic\Logic.csproj" />
    <ProjectReference Include="..\..\Model\Model.csproj" />
  </ItemGroup>

</Project>
